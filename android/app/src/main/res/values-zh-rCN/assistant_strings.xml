    <string name="assistant_supports_images">模型支持图片</string>
    <string name="assistant_images_hint">仅为视觉模型开启。拍照提问会将一张眼镜相机快照发送至此 API。</string>
    <string name="assistant_supports_tools">模型支持工具调用</string>
    <string name="assistant_tools_hint">允许模型选择拍照、显示卡片和控制音乐等操作。请仅在模型支持工具调用时开启。通知摘要独立使用。</string>
    <string name="assistant_speak_replies">朗读回复</string>
    <string name="assistant_speech_hint">使用现有语音播放设置，并在需要时回退至系统语音。云端语音使用单独配置的阿里云密钥，不使用此 API 密钥。</string>
    <string name="assistant_insecure_http">允许不安全的局域网 HTTP</string>
